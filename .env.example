APP_ENV=local
APP_PROJECT_NAME=FastAPI Base
APP_DATABASE_URL=postgresql+asyncpg://<username>:<password>@postgres:5432/fastapi_base

POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>

# JWT keys environment variables
APP_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private_key>\n-----END PRIVATE KEY-----"
APP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<public_key>\n-----END PUBLIC KEY-----"

# Email environment variables
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=587
APP_SMTP_USERNAME=<email_username>
APP_SMTP_PASSWORD=<email_password>
APP_SMTP_START_TLS=true
APP_MAIL_FROM="FastAPI Base <<email_username>>"
APP_FRONTEND_URL=http://localhost:3000